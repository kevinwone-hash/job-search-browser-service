# Browserbase credentials
# Get these from https://browserbase.com/dashboard
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# FastAPI job-search-os base URL and API key
JOB_SEARCH_API_URL=https://job-search-os-production.up.railway.app
JOB_SEARCH_API_KEY=your_api_key_here

# Service config
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Kevin's personal info for ATS form filling
# These are used by the form filler — keep this file out of version control
APPLICANT_FIRST_NAME=Kevin
APPLICANT_LAST_NAME=Watson
APPLICANT_EMAIL=kevinwone@gmail.com
APPLICANT_PHONE=
APPLICANT_LINKEDIN_URL=
APPLICANT_LOCATION_CITY=Atlanta
APPLICANT_LOCATION_STATE=GA
APPLICANT_LOCATION_COUNTRY=United States

# Resume file path (absolute path on the server, or a publicly accessible URL)
# For Railway deployment, use a cloud-accessible URL (R2, etc.)
RESUME_URL=
